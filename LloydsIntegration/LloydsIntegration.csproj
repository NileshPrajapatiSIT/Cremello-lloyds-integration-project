<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc comment on a public member. We document classes, endpoints, and key
         infrastructure, not every single DTO property, so this warning is expected and not actionable. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lloyds\Lloyds.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TODO: dummy placeholder certificates — see Certificates/README.md -->
    <None Include="Certificates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
